{
  "schema_version": 1,
  "registry_id": "spyctres_benchmark_sources_2026-11-13",
  "status": "source_inventory_with_proposed_star_level_cohort",
  "purpose": "Product-specific capability and reference-quality inventory for a future star-grouped Spyctres benchmark. The 60+12 proposal is in proposed_cohort_v1.json; it is not locked, downloaded, or fitted.",
  "proposed_target_inventory": "proposed_cohort_v1.json",
  "model_family": {
    "name": "PHOENIX-ACES HiRes",
    "teff_range_K": [2300.0, 12000.0],
    "ordinary_accuracy_exclusions": [
      "O stars and early-B stars outside the installed grid",
      "white dwarfs and Wolf-Rayet stars",
      "carbon and S stars",
      "strong-emission and composite spectra",
      "other targets whose dominant physics is absent from the selected grid"
    ]
  },
  "cohort_rules": {
    "supported_holdout_target": 60,
    "stress_target_minimum": 12,
    "grouping_unit": "unique_star",
    "same_star_different_release_counts_once": true,
    "same_star_repeated_observations_count_once_for_accuracy_denominator": true,
    "development_target_aliases_must_not_enter_holdout": true,
    "holdout_reference_values_visible_to_fitting": false,
    "holdout_results_may_inform_current_method_tuning": false,
    "automatic_and_human_assisted_results_are_separate": true,
    "benchmark_eligibility_may_use_independent_references": true,
    "automatic_classification_may_use_reference_values": false,
    "ordinary_conditional_and_unsupported_tracks_are_reported_separately": true
  },
  "pre_registered_reporting": {
    "star_level_bootstrap": true,
    "confidence_intervals": true,
    "automatic_acceptance_fraction": true,
    "severe_error_rate_among_accepted": true,
    "group_by": ["stellar_class", "luminosity_class", "instrument_product_family"],
    "small_group_policy": "Label sparse subgroups exploratory rather than reporting a precise accuracy claim.",
    "failure_diagnosis_outcomes": [
      "demonstrated_cause",
      "supported_unconfirmed_hypothesis",
      "unresolved_failure"
    ]
  },
  "sources": [
