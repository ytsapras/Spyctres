      "spectral_regime": "FGK",
      "resolution_tier": "high",
      "reader": "gbs_v3_ascii",
      "instrument_gate_status": "ready_for_candidate_inventory",
      "reference_policy": {
        "teff": "primary_independent",
        "logg": "primary_independent",
        "feh": "secondary_spectroscopic",
        "spectral_type": "morphology_only"
      },
      "notes": "Use unique-star grouping across the multiple source spectrographs. Stars flagged with indirect angular diameters require secondary/reference-flagged treatment."
